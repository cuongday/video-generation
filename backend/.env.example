# AI Video Generator — Environment Variables
# Copy this file to .env and fill in your API keys

# App
APP_NAME="AI Video Generator"
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./video_generator.db

# Security — CHANGE THESE IN PRODUCTION
SECRET_KEY=change-me-to-a-strong-random-secret-key
FERNET_KEY=change-me-to-a-32-byte-base64-encoded-key

# API Provider Keys
# OpenAI (Sora 2)
OPENAI_API_KEY=sk-your-openai-key-here

# Kuaishou Kling 3.0
KUAIHOU_API_KEY=your-kling-api-key-here

# Seedance (AceDataCloud)
SEEDANCE_API_KEY=your-seedance-api-key-here

# Flux
FLUX_API_KEY=your-flux-api-key-here

# Server
HOST=0.0.0.0
PORT=8000

# Storage
OUTPUTS_DIR=../outputs
